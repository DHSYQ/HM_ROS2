<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================ -->
<!-- Genkiarm ROS2 URDF — 6-DOF 桌面机械臂                                         -->
<!-- 适配 RViz2 可视化 + 现有 TCP 桥接链路                                          -->
<!--                                                                               -->
<!-- 关节名匹配 /joint_states 话题:                                                 -->
<!--   joint_1 (腰部旋转)     ID 1 / 11                                              -->
<!--   joint_2 (肩部俯仰)     ID 2 / 12                                              -->
<!--   joint_3 (肘部俯仰)     ID 3 / 13                                              -->
<!--   joint_4 (腕部俯仰)     ID 4 / 14                                              -->
<!--   joint_5 (腕部横滚)     ID 5 / 15                                              -->
<!--   joint_6 (夹爪)         ID 6 / 16                                              -->
<!-- ============================================================================ -->
<robot name="genkiarm">

  <!-- ================================================================ -->
  <!-- 材质 (PETG, 密度 1270 kg/m³)                                     -->
  <!-- ================================================================ -->
  <material name="petg_grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="petg_dark">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>
  <material name="petg_blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>
  <material name="petg_orange">
    <color rgba="0.9 0.5 0.2 1.0"/>
  </material>
  <material name="petg_yellow">
    <color rgba="0.9 0.8 0.2 1.0"/>
  </material>
  <material name="petg_red">
    <color rgba="0.9 0.2 0.2 1.0"/>
  </material>

  <!-- ================================================================ -->
  <!-- LINK_BASE — 固定底座                                              -->
  <!-- ================================================================ -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://r01_test_package/meshes/AAA.stl"/>
      </geometry>
      <material name="petg_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.015"/>
      </geometry>
      <origin xyz="0 0 0.006"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0.006"/>
      <inertia ixx="1.5e-5" ixy="0" ixz="0"
               iyy="1.5e-5" iyz="0"
               izz="2.1e-5"/>
    </inertial>
  </link>

  <!-- ================================================================ -->
  <!-- LINK_YAW — 腰部旋转                                               -->
  <!-- ================================================================ -->
  <link name="link_yaw">
    <visual>
      <geometry>
        <mesh filename="package://r01_test_package/meshes/BBB.stl"/>
      </geometry>
      <material name="petg_dark"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <origin xyz="0.02 0 0"/>
    </collision>
    <inertial>
      <mass value="0.16"/>
      <origin xyz="0.04 0 0"/>
      <inertia ixx="8.5e-5" ixy="0" ixz="0"
               iyy="8.5e-5" iyz="0"
               izz="5.3e-5"/>
    </inertial>
  </link>

  <!-- ================================================================ -->
  <!-- LINK_SHOULDER — 肩部                                              -->
  <!-- ================================================================ -->
  <link name="link_shoulder">
    <visual>
      <geometry>
        <mesh filename="package://r01_test_package/meshes/CCC.stl"/>
      </geometry>
      <material name="petg_blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.025" length="0.12"/>
      </geometry>
      <origin xyz="0 0 0.06"/>
    </collision>
    <inertial>
      <mass value="0.38"/>
      <origin xyz="0 0 0.06"/>
      <inertia ixx="5.5e-4" ixy="0" ixz="0"
               iyy="5.5e-4" iyz="0"
               izz="1.2e-4"/>
    </inertial>
  </link>

  <!-- ================================================================ -->
  <!-- LINK_ELBOW — 肘部                                                 -->
  <!-- ================================================================ -->
  <link name="link_elbow">
    <visual>
      <geometry>
        <mesh filename="package://r01_test_package/meshes/CCC2.stl"/>
      </geometry>
      <material name="petg_orange"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.025" length="0.12"/>
      </geometry>
      <origin xyz="0 0 0.06"/>
    </collision>
    <inertial>
      <mass value="0.24"/>
      <origin xyz="0 0 0.06"/>
      <inertia ixx="3.5e-4" ixy="0" ixz="0"
               iyy="3.5e-4" iyz="0"
               izz="7.5e-5"/>
    </inertial>
  </link>

  <!-- ================================================================ -->
  <!-- LINK_WRIST_PITCH — 腕部俯仰                                       -->
  <!-- ================================================================ -->
  <link name="link_wrist_pitch">
    <visual>
      <geometry>
        <mesh filename="package://r01_test_package/meshes/DDD.stl"/>
      </geometry>
      <material name="petg_yellow"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.022" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0.03"/>
    </collision>
    <inertial>
      <mass value="0.07"/>
      <origin xyz="0 0 0.03"/>
      <inertia ixx="2.5e-5" ixy="0" ixz="0"
               iyy="2.5e-5" iyz="0"
               izz="1.7e-5"/>
    </inertial>
  </link>

  <!-- ================================================================ -->
  <!-- LINK_WRIST_ROLL — 腕部横滚                                        -->
  <!-- ================================================================ -->
  <link name="link_wrist_roll">
    <visual>
      <geometry>
        <mesh filename="package://r01_test_package/meshes/EEE.stl"/>
      </geometry>
      <material name="petg_red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.01 0.01 0.04"/>
      </geometry>
      <origin xyz="0 0.02 0.065"/>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0.01 0.065"/>
      <inertia ixx="4e-6" ixy="0" ixz="0"
               iyy="4e-6" iyz="0"
               izz="1.7e-6"/>
    </inertial>
  </link>

  <!-- ================================================================ -->
  <!-- LINK_GRIPPER — 夹爪                                               -->
  <!-- ================================================================ -->
  <link name="link_gripper">
    <visual>
      <geometry>
        <mesh filename="package://r01_test_package/meshes/FFF.stl"/>
      </geometry>
      <material name="petg_red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.01 0.01 0.04"/>
      </geometry>
      <origin xyz="0 0.01 0.045"/>
    </collision>
    <inertial>
      <mass value="0.09"/>
      <origin xyz="0 0.005 0.045"/>
      <inertia ixx="1.5e-5" ixy="0" ixz="0"
               iyy="1.5e-5" iyz="0"
               izz="7.5e-6"/>
    </inertial>
  </link>

  <!-- ================================================================ -->
  <!-- 关节定义                                                          -->
  <!-- ================================================================ -->

  <!-- joint_1: base_link → link_yaw (腰部旋转, 绕 X 轴) -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_yaw"/>
    <origin xyz="-0.013 0 0.0265" rpy="0 -1.5708 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="35" velocity="3.14"/>
    <dynamics damping="2.0" friction="0.5"/>
  </joint>

  <!-- joint_2: link_yaw → link_shoulder (肩部俯仰, 绕 Y 轴) -->
  <joint name="joint_2" type="revolute">
    <parent link="link_yaw"/>
    <child link="link_shoulder"/>
    <origin xyz="0.081 0 0" rpy="0 1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="35" velocity="3.14"/>
    <dynamics damping="2.0" friction="0.5"/>
  </joint>

  <!-- joint_3: link_shoulder → link_elbow (肘部俯仰, 绕 Y 轴) -->
  <joint name="joint_3" type="revolute">
    <parent link="link_shoulder"/>
    <child link="link_elbow"/>
    <origin xyz="0 0 0.118" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="35" velocity="3.14"/>
    <dynamics damping="2.0" friction="0.5"/>
  </joint>

  <!-- joint_4: link_elbow → link_wrist_pitch (腕部俯仰, 绕 Y 轴) -->
  <joint name="joint_4" type="revolute">
    <parent link="link_elbow"/>
    <child link="link_wrist_pitch"/>
    <origin xyz="0 0 0.118" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="35" velocity="3.14"/>
    <dynamics damping="2.0" friction="0.5"/>
  </joint>

  <!-- joint_5: link_wrist_pitch → link_wrist_roll (腕部横滚, 绕 Z 轴) -->
  <joint name="joint_5" type="revolute">
    <parent link="link_wrist_pitch"/>
    <child link="link_wrist_roll"/>
    <origin xyz="0 0 0.0635" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="35" velocity="3.14"/>
    <dynamics damping="2.0" friction="0.5"/>
  </joint>

  <!-- joint_6: link_wrist_roll → link_gripper (夹爪, 绕 X 轴) -->
  <joint name="joint_6" type="revolute">
    <parent link="link_wrist_roll"/>
    <child link="link_gripper"/>
    <origin xyz="0 -0.0132 0.021" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="1.5708" effort="35" velocity="3.14"/>
    <dynamics damping="2.0" friction="0.5"/>
  </joint>

  <!-- ================================================================ -->
  <!-- 末端执行器 site                                                   -->
  <!-- ================================================================ -->
  <link name="gripper_tip"/>
  <joint name="gripper_tip_joint" type="fixed">
    <parent link="link_gripper"/>
    <child link="gripper_tip"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  </robot>